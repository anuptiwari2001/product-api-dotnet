@model ProductDto
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container p-4 border">
    <h1 class="text-primary">Edit Product</h1>
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Edit" method="post">
        <input asp-for="ProductId" type="hidden" />
        <div class="row mb-2 align-items-center">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-2 align-items-center">
            <label asp-for="CategoryName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-2 align-items-center">
            <label asp-for="Description" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-2 align-items-center">
            <label asp-for="ImageUrl" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3 align-items-center">
            <label asp-for="Price" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6 mb-2">
                <a asp-action="ProductIndex" class="btn btn-primary w-100">Back to List</a>
            </div>
            <div class="col-sm-6 mb-2">
                <button type="submit" class="btn btn-success w-100">Save</button>
            </div>
        </div>
    </form>
</div>
