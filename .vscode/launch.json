{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mango.Services.ProductAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-product-api",
      "program": "${workspaceFolder}/Mango.Services.ProductAPI/bin/Debug/net10.0/Mango.Services.ProductAPI.dll",
      "cwd": "${workspaceFolder}/Mango.Services.ProductAPI",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7132;http://localhost:5095"
      }
    },
    {
      "name": "Mango.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/Mango.Web/bin/Debug/net10.0/Mango.Web.dll",
      "cwd": "${workspaceFolder}/Mango.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://localhost:7063)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7063;http://localhost:5083"
      }
    }
  ],
  "compounds": [
    {
      "name": "Web + ProductAPI",
      "configurations": [
        "Mango.Services.ProductAPI",
        "Mango.Web"
      ],
      "stopAll": true
    }
  ]
}
